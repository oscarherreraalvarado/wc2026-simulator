# Supabase — API usa service role (bypass RLS). Nunca exponer en el cliente.

# Local:  http://127.0.0.1:54321  |  Remoto: https://xxxx.supabase.co
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret

# Server
API_PORT=3600
CORS_ORIGINS=http://localhost:4600
SUPABASE_ANON_KEY=eyJ...

# Admin — resultados oficiales (header x-admin-key en POST /official-results)
ADMIN_API_KEY=dev-admin-key-change-me
