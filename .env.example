# Supabase — copia a .env y rellena según el modo elegido

# ─── Modo LOCAL (supabase start) ───────────────────────────────────────────
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=          # ver: pnpm db:status
# SUPABASE_SERVICE_ROLE_KEY=  # ver: pnpm db:status
# SUPABASE_JWT_SECRET=        # ver: pnpm db:status

# ─── Modo REMOTO (supabase.com dashboard → Settings → API) ────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret

# API (NestJS)
API_PORT=3600
API_URL=http://localhost:3600
CORS_ORIGINS=http://localhost:4600,https://wc2026.vercel.app

# Admin — carga de resultados oficiales (header x-admin-key)
ADMIN_API_KEY=dev-admin-key-change-me

# Web (Angular)
WEB_API_URL=http://localhost:3600
WEB_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
WEB_SUPABASE_ANON_KEY=eyJ...

# Deploy (CI/CD secrets — no commitear valores reales)
# RENDER_DEPLOY_HOOK_URL=
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
